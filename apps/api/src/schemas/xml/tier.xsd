<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <!-- Pulse & Pass Ticket Tier XML Schema Definition (XSD) -->
  <xs:element name="tier">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="1"/>
              <xs:maxLength value="100"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>

        <xs:element name="description" type="xs:string" minOccurs="0"/>

        <xs:element name="price_paise">
          <xs:simpleType>
            <xs:restriction base="xs:nonNegativeInteger"/>
          </xs:simpleType>
        </xs:element>

        <xs:element name="capacity">
          <xs:simpleType>
            <xs:restriction base="xs:positiveInteger"/>
          </xs:simpleType>
        </xs:element>

        <xs:element name="sales_start" type="xs:string" minOccurs="0"/>
        <xs:element name="sales_end" type="xs:string" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="currency" type="xs:string" default="INR"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
