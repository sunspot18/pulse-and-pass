{
  "name": "pulse-and-pass",
  "version": "1.0.0",
  "private": true,
  "description": "Industrial Event Management & Digital Ticketing System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan.bold,yellow.bold\" \"npm run dev --workspace=@pulsepass/api\" \"npm run dev --workspace=@pulsepass/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@pulsepass/api",
    "db:seed": "npm run db:seed --workspace=@pulsepass/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.8.2"
  }
}
